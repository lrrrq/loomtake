{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mplus-mutation-contract/v1",
  "title": "M+ Mutation Contract",
  "type": "object",
  "required": [
    "operation",
    "mutation_kind",
    "target_type",
    "target_id",
    "request_sha256",
    "changed_fields",
    "preserved_scope",
    "recovery_mode"
  ],
  "properties": {
    "operation": {"type": "string", "minLength": 3, "maxLength": 120},
    "mutation_kind": {
      "enum": [
        "append_immutable",
        "patch_field",
        "advance_pointer",
        "rebuild_projection",
        "cleanup_ephemeral",
        "archive_project",
        "restore_project",
        "purge_project"
      ]
    },
    "target_type": {"type": "string", "minLength": 1, "maxLength": 80},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changed_fields": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 120},
      "uniqueItems": true
    },
    "preserved_scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 120},
      "uniqueItems": true
    },
    "recovery_mode": {"type": "string", "minLength": 1, "maxLength": 80},
    "confirmation_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
