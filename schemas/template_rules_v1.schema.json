{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mplus.local/schemas/template_rules_v1.schema.json",
  "title": "M+ Template Rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "category_id", "rules"],
  "properties": {
    "schema_version": {"const": "mplus-template-rules/v1"},
    "category_id": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "selector", "field", "level", "allowed_event_roles", "rationale"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "selector": {
            "type": "object",
            "required": ["source_sheet", "slot_start", "slot_end"],
            "properties": {
              "source_sheet": {"type": "string", "minLength": 1},
              "slot_start": {"type": "integer", "minimum": 1},
              "slot_end": {"type": "integer", "minimum": 1}
            }
          },
          "field": {"type": "string", "minLength": 1},
          "level": {"enum": ["structural_required", "technique_default", "example_only"]},
          "allowed_event_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
